# Copy real values here. Do not commit real secrets.
# The guided installer (python3 install.py) prompts for these values and writes
# esphome/secrets.yaml for you; edit this example by hand only for a manual
# installation.
wifi_ssid: "YourWiFi"
wifi_password: "YourWiFiPassword"
timezone: "Your/Timezone"
fallback_ap_password: "ChangeThisAPPassword"
kickstart_web_username: "admin"
kickstart_web_password: "ChangeThisWebPassword"
# Replace this valid dummy key with: openssl rand -base64 32
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
